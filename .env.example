# Copy this file to .env (cp .env.example .env) and fill in real values.
# .env is git-ignored: never commit real keys or passwords.

# dev | test | prod
APP_ENV=dev

# Supabase Postgres connectivity.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# LLM provider keys go here once the gateway calls a provider.
GEMINI_API_KEY=

# App config
APP_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
